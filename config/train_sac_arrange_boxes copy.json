{
  "output_dir": "outputs/arrange_boxes_sac",
  "job_name": "arrange_boxes_sac",
  "seed": 42,
  "steps": 100000,
  "batch_size": 256,
  "policy": {
    "type": "sac",
    "device": "cpu",
    "n_obs_steps": 1,
    "repo_id": "local/arrange_boxes_sac",
    "normalization_mapping": {
      "VISUAL": "MEAN_STD",
      "STATE": "MIN_MAX",
      "ENV": "MIN_MAX"
    },
    "input_features": {
      "state": {
        "type": "STATE",
        "shape": [18],
        "source": "observation.state"
      },
      "image": {
        "type": "VISUAL",
        "shape": [3, 128, 128],
        "source": "observation.image"
      }
    },
    "output_features": {
      "action": {
        "type": "ACTION",
        "shape": [4]
      }
    }
  },
  "env": {
    "type": "hil",
    "name": "franka_sim",
    "task": "PandaArrangeBoxesKeyboard-v0",
    "device": "cpu",
    "fps": 10,
    "use_viewer": false,
    "use_gamepad": false,
    "wrapper": {
      "gripper_penalty": -0.02,
      "display_cameras": false,
      "add_joint_velocity_to_observation": true,
      "add_ee_pose_to_observation": true,
      "resize_size": [128, 128],
      "control_time_s": 15.0,
      "control_mode": "keyboard"
    }
  },
  "dataset": {
    "repo_id": "aractingi/franka_sim_pick_lift_6",
    "revision": null,
    "root": null,
    "episodes": null,
    "use_imagenet_stats": false,
    "video_backend": "pyav",
    "image_transforms": {
      "enable": false
    }
  },
  "eval": {
    "batch_size": 1,
    "n_episodes": 1,
    "use_async_envs": false
  },
  "optimizer": {
    "type": "adam",
    "lr": 0.0003,
    "weight_decay": 0.0
  },
  "scheduler": {
    "type": "cosine_decay_with_warmup",
    "num_warmup_steps": 1000,
    "num_decay_steps": 90000,
    "peak_lr": 0.0003,
    "decay_lr": 0.00003
  },
  "use_policy_training_preset": false
}
